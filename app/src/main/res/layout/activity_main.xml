<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <!-- Fullscreen Video Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:resize_mode="zoom"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <!-- Buffering indicator -->
    <LinearLayout
        android:id="@+id/bufferingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_info_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="44dp"
        android:paddingEnd="64dp"
        android:paddingBottom="44dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/outfit"
            android:text="@string/buffering"
            android:textColor="@color/text_primary"
            android:textSize="32sp" />
    </LinearLayout>

    <!-- Error view with retry / next channel actions -->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_info_card"
        android:elevation="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="48dp"
        android:paddingEnd="64dp"
        android:paddingBottom="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="840dp"
            android:text="@string/error_loading"
            android:textColor="@color/text_primary"
            android:textSize="40sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="104dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:gravity="center"
                android:minWidth="300dp"
                android:nextFocusRight="@id/btnNextChannel"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:text="Yeniden dene"
                android:textColor="@color/text_primary"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/btnNextChannel"
                android:layout_width="wrap_content"
                android:layout_height="104dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:gravity="center"
                android:minWidth="300dp"
                android:nextFocusLeft="@id/btnRetry"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:text="Sonraki kanal"
                android:textColor="@color/text_primary"
                android:textSize="36sp" />
        </LinearLayout>
    </LinearLayout>


    <!-- Top right: clock, date and settings icon (header px-16 py-6) -->
    <LinearLayout
        android:id="@+id/topRightBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_clock" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clockText"
                style="@style/GlassSora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:includeFontPadding="false"
                android:textColor="@color/text_on_surface"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="20:45" />

            <TextView
                android:id="@+id/dateText"
                style="@style/GlassOutfit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="14 Ekim Salı" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnTopSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_round_button"
            android:clickable="true"
            android:contentDescription="@string/settings"
            android:focusable="false"
            android:padding="10dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Left glass panel: 470 px wide, full height; real blur behind via BlurBackdropView -->
    <FrameLayout
        android:id="@+id/channelListDrawer"
        android:layout_width="@dimen/panel_width"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.mibox.iptv.BlurBackdropView
            android:id="@+id/blurPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:edgeColor="#1FFFFFFF"
            app:rightEdgeOnly="true"
            app:tint="#661F3A68" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="96dp"
            android:paddingEnd="32dp"
            android:paddingBottom="32dp">

            <!-- Title row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tv" />

                <TextView
                    android:id="@+id/drawerTitle"
                    style="@style/GlassSora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:letterSpacing="0.05"
                    android:text="@string/app_name"
                    android:textColor="@color/tint_light"
                    android:textSize="26sp" />
            </LinearLayout>

            <!-- Category chips (derived from channel groups) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chipsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                tools:listitem="@layout/item_category" />

            <!-- Channel list: clipped to its own area (between chips and footer) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:descendantFocusability="afterDescendants"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                tools:listitem="@layout/item_channel" />

            <!-- Settings (replaces chips + list while active) -->
            <!-- TAB 2: Settings -->
            <ScrollView
                android:id="@+id/settingsScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="24dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="KUMANDA" />

                    <LinearLayout
                        android:id="@+id/btnToggleDirection"
                        style="@style/SettingsCard"
                        android:nextFocusUp="@id/btnOpenSettings">

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="Kanal değiştirme yönü" />

                        <TextView
                            android:id="@+id/txtDirectionStatus"
                            style="@style/SettingsDesc"
                            android:textColor="@color/accent"
                            tools:text="▲ sonraki  ·  ▼ önceki" />
                    </LinearLayout>

                    <TextView
                        style="@style/SectionLabel"
                        android:text="GÖRÜNÜM" />

                    <LinearLayout
                        android:id="@+id/btnToggleBlur"
                        style="@style/SettingsCard">

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="Arka plan bulanıklığı" />

                        <TextView
                            android:id="@+id/txtBlurStatus"
                            style="@style/SettingsDesc"
                            android:textColor="@color/glow"
                            tools:text="Açık" />
                    </LinearLayout>

                    <TextView
                        style="@style/SectionLabel"
                        android:text="KANALLAR" />

                    <LinearLayout
                        android:id="@+id/btnSettingsReorder"
                        style="@style/SettingsCard">

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="Sıralama modunu aç" />

                        <TextView
                            style="@style/SettingsDesc"
                            android:text="OK ile tut, ▲▼ ile taşı" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnSettingsDelete"
                        style="@style/SettingsCard">

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="Silme modunu aç" />

                        <TextView
                            style="@style/SettingsDesc"
                            android:text="İstemediğin kanalları kaldır" />
                    </LinearLayout>

                    <TextView
                        style="@style/SectionLabel"
                        android:text="GÜVENLİK" />

                    <TextView
                        android:id="@+id/txtDeletedSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="16dp"
                        android:text="Hafızada silinmiş kanal bulunmuyor."
                        android:textColor="@color/text_secondary"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:id="@+id/btnRestoreDeleted"
                        style="@style/SettingsCard">

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="Silinen kanalları geri yükle" />

                        <TextView
                            style="@style/SettingsDesc"
                            android:text="Sıralama bozulmaz" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnResetAll"
                        style="@style/SettingsCard">

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="Listeyi ve sıralamayı sıfırla"
                            android:textColor="@color/warning" />

                        <TextView
                            style="@style/SettingsDesc"
                            android:text="Her şey ilk haline döner" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnSetPin"
                        style="@style/SettingsCard">

                        <TextView
                            android:id="@+id/txtSetPinTitle"
                            style="@style/SettingsTitle"
                            android:text="Sıfırlama şifresi ata" />

                        <TextView
                            android:id="@+id/txtPinStatus"
                            style="@style/SettingsDesc"
                            android:text="Şifre atanmadı (Sıfırlama için şifre belirleyin)" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnClearPin"
                        style="@style/SettingsCard"
                        android:visibility="gone">

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="Şifre korumasını kaldır"
                            android:textColor="@color/danger" />

                        <TextView
                            style="@style/SettingsDesc"
                            android:text="Mevcut şifre doğrulanır" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>




            <!-- D-Pad hint line, only shown while a mode (settings / reorder / delete) is active -->
            <TextView
                android:id="@+id/dpadHintText"
                style="@style/GlassOutfit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/dpad_hint_channels"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Footer (pt-3, border-t white/10, px-2) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_10" />

            <TextView
                android:id="@+id/btnOpenSettings"
                style="@style/GlassOutfit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_footer_button"
                android:clickable="true"
                android:drawableStart="@drawable/ic_settings"
                android:drawablePadding="8dp"
                android:drawableTint="@color/text_secondary"
                android:focusable="true"
                android:gravity="center_vertical"
                android:letterSpacing="0.04"
                android:minHeight="40dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/settings"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="UnusedAttribute" />
        </LinearLayout>
    </FrameLayout>

    <!-- Channel context menu (long press OK on a row) -->
    <FrameLayout
        android:id="@+id/channelMenuOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/scrim"
        android:clickable="true"
        android:elevation="56dp"
        android:focusable="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/channelMenuTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="40sp"
                tools:text="TRT 2 HD" />

            <TextView
                android:id="@+id/channelMenuMove"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:gravity="center_vertical"
                android:nextFocusLeft="@id/channelMenuMove"
                android:nextFocusRight="@id/channelMenuMove"
                android:nextFocusUp="@id/channelMenuMove"
                android:nextFocusDown="@id/channelMenuDelete"
                android:paddingStart="32dp"
                android:text="Taşı"
                android:textColor="@color/text_primary"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/channelMenuDelete"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:gravity="center_vertical"
                android:nextFocusLeft="@id/channelMenuDelete"
                android:nextFocusRight="@id/channelMenuDelete"
                android:nextFocusUp="@id/channelMenuMove"
                android:nextFocusDown="@id/channelMenuDelete"
                android:paddingStart="32dp"
                android:text="Sil"
                android:textColor="@color/danger"
                android:textSize="36sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Translucent Glass PIN / Password Dialog Overlay (TV Remote Friendly) -->
    <FrameLayout
        android:id="@+id/pinModalOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#B3000000"
        android:clickable="true"
        android:elevation="64dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="680dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="44dp">

            <TextView
                android:id="@+id/pinModalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:text="Sıfırlama Şifresi"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pinModalSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="4 haneli şifreyi girin"
                android:textColor="@color/text_secondary"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/pinDigitsDisplay"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_logo_pill"
                android:fontFamily="@font/sora"
                android:gravity="center"
                android:letterSpacing="0.35"
                android:text="○ ○ ○ ○"
                android:textColor="@color/glow"
                android:textSize="44sp"
                android:textStyle="bold" />

            <!-- 3x4 D-Pad Numpad Grid -->
            <GridLayout
                android:id="@+id/pinNumpadGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="4">

                <TextView android:id="@+id/pinKey1" android:layout_width="0dp" android:layout_height="88dp" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:text="1" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold" />
                <TextView android:id="@+id/pinKey2" android:layout_width="0dp" android:layout_height="88dp" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:text="2" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold" />
                <TextView android:id="@+id/pinKey3" android:layout_width="0dp" android:layout_height="88dp" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:text="3" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold" />

                <TextView android:id="@+id/pinKey4" android:layout_width="0dp" android:layout_height="88dp" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:text="4" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold" />
                <TextView android:id="@+id/pinKey5" android:layout_width="0dp" android:layout_height="88dp" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:text="5" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold" />
                <TextView android:id="@+id/pinKey6" android:layout_width="0dp" android:layout_height="88dp" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:text="6" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold" />

                <TextView android:id="@+id/pinKey7" android:layout_width="0dp" android:layout_height="88dp" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:text="7" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold" />
                <TextView android:id="@+id/pinKey8" android:layout_width="0dp" android:layout_height="88dp" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:text="8" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold" />
                <TextView android:id="@+id/pinKey9" android:layout_width="0dp" android:layout_height="88dp" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:text="9" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold" />

                <TextView android:id="@+id/pinKeyBack" android:layout_width="0dp" android:layout_height="88dp" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:text="⌫ Sil" android:textColor="#FBBF24" android:textSize="26sp" android:textStyle="bold" />
                <TextView android:id="@+id/pinKey0" android:layout_width="0dp" android:layout_height="88dp" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:text="0" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold" />
                <TextView android:id="@+id/pinKeyCancel" android:layout_width="0dp" android:layout_height="88dp" android:layout_columnWeight="1" android:layout_margin="8dp" android:background="@drawable/bg_delete_btn" android:clickable="true" android:focusable="true" android:gravity="center" android:text="İptal" android:textColor="#F87171" android:textSize="26sp" android:textStyle="bold" />
            </GridLayout>
        </LinearLayout>
    </FrameLayout>


    <!-- Info strip: left 500, right 64, bottom 32, p-7, 16 radius (Stitch). Shown while the panel is open and 3s after a channel change -->
    <FrameLayout
        android:id="@+id/bottomInfoBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="500dp"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="32dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <com.mibox.iptv.BlurBackdropView
            android:id="@+id/blurStrip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:corner="16dp"
            app:edgeColor="#1FFFFFFF"
            app:tint="#661F3A68" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_number_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/bannerChannelNumber"
                        style="@style/GlassSora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tint_light"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="03" />

                    <TextView
                        android:id="@+id/bannerChannelName"
                        style="@style/GlassSora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="420dp"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="ATV HD" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_live_badge_big"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_progress_dot" />

                    <TextView
                        style="@style/GlassOutfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.1"
                        android:text="CANLI YAYIN"
                        android:textColor="@color/live_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/bannerGroup"
                    style="@style/GlassOutfit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_tag"
                    android:ellipsize="end"
                    android:letterSpacing="0.05"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="Ulusal &amp; Dizi" />
            </LinearLayout>

            <TextView
                android:id="@+id/bannerTitle"
                style="@style/GlassSora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:letterSpacing="-0.025"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="ATV HD" />

            <TextView
                android:id="@+id/bannerStatus"
                style="@style/GlassOutfit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                tools:text="Canlı yayın oynatılıyor" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/border_10" />

            <!-- Remote hints: only keys that really work in the app -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <TextView
                    style="@style/HintKey"
                    android:background="@drawable/bg_key_primary"
                    android:text="OK"
                    android:textColor="@color/on_primary" />

                <TextView
                    android:id="@+id/hintOkLabel"
                    style="@style/HintLabel"
                    android:text="Kanal Listesi" />

                <TextView
                    style="@style/HintKey"
                    android:layout_marginStart="20dp"
                    android:text="▲▼" />

                <TextView
                    android:id="@+id/hintUpDownLabel"
                    style="@style/HintLabel"
                    android:text="Kanal Değiştir" />

                <TextView
                    android:id="@+id/hintBackKey"
                    style="@style/HintKey"
                    android:layout_marginStart="20dp"
                    android:text="GERİ" />

                <TextView
                    android:id="@+id/hintBackLabel"
                    style="@style/HintLabel"
                    android:text="Gizle" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
