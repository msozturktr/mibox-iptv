<?xml version="1.0" encoding="utf-8"?>
<!-- Channel row: transparent unless focused (rgba(58,120,232,.35), 2px #3A78E8 border, left pillar) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/focus_fill" />
                    <stroke android:width="2dp" android:color="@color/accent" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item
                android:width="6dp"
                android:bottom="8dp"
                android:gravity="start"
                android:top="8dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tint_light" />
                    <corners
                        android:bottomRightRadius="3dp"
                        android:topRightRadius="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
