<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent parliament blue strip; denser fill (~78%) keeps it readable over broadcast subtitles; no backdrop blur over a SurfaceView -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/strip_solid" />
    <stroke android:width="1dp" android:color="@color/glass_stroke" />
    <corners android:radius="16dp" />
</shape>
