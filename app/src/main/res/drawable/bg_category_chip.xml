<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/secondary_container" />
            <stroke android:width="3dp" android:color="@color/glow" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/secondary_container" />
            <stroke android:width="1dp" android:color="@color/tint_light" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_strong" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <stroke android:width="1dp" android:color="@color/border_10" />
            <corners android:radius="40dp" />
        </shape>
    </item>
</selector>
