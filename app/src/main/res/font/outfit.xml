<?xml version="1.0" encoding="utf-8"?>
<!-- Outfit (OFL) variable font; weights are selected through the wght axis (API 26+). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/outfit_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400"
        android:fontWeight="400" />
    <font
        android:font="@font/outfit_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 500"
        android:fontWeight="500" />
    <font
        android:font="@font/outfit_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 600"
        android:fontWeight="600" />
</font-family>
